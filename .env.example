# =============================================================================
# TechResearch Agent — environment variable template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All keys here are OPTIONAL for Phase 0: the project boots and tests run
# without any of them. They become required only when you actually enable the
# corresponding feature in later phases.
# =============================================================================

# ---- LLM (DashScope / Qwen, OpenAI-compatible endpoint) -------------------
# Apply for one at https://bailian.console.aliyun.com/  ->  API-KEY 管理
# Leave empty to run in "fake" mode (no real LLM calls).
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-max
QWEN_MODEL_FAST=qwen3.8-flash
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_RERANK_MODEL=qwen3-rerank
# OpenAI-compatible base URL. The legacy bare domain still works; the new
# per-workspace form is https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- Provider selection ---------------------------------------------------
# fake | qwen   (default: fake when DASHSCOPE_API_KEY is empty)
LLM_PROVIDER=

# ---- LangSmith observability (phase 1+) -----------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tech-research-agent
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- Prompt Hub (Phase 3+) -----------------------------------------------
# local    : force local manifest, zero network (default, tests use this).
# langsmith: force remote; any failure raises.
# hybrid   : try remote, fall back to local on error.
PROMPT_SOURCE=local
# Remote-pull cache TTL in seconds (hybrid/langsmith mode).
PROMPT_CACHE_TTL=300
# Per-call timeout when talking to LangSmith prompts API.
LANGSMITH_PROMPT_TIMEOUT=10

# ---- Web search (phase 1+) ------------------------------------------------
TAVILY_API_KEY=
# Optional pool for round-robin distribution and automatic failover. Keep the
# singular variable for backward compatibility; duplicates are removed.
TAVILY_API_KEYS=
# Optional local compatible proxy. Run `scripts/tavily-proxy.ps1 start`; keep
# it bound to 127.0.0.1 because the upstream project has no caller auth.
TAVILY_PROXY_URL=

# ---- Research execution ----------------------------------------------------
# Per-task wall-clock timeout in seconds. Deep benchmark tasks need more than 60s.
RESEARCH_TIMEOUT_SECONDS=300

# ---- Feishu / Lark export (phase 5+) --------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=

# ---- Storage paths ---------------------------------------------------------
VECTOR_DB_PATH=./data/chroma
MEMORY_DB_PATH=./data/memory

# ---- Budget (defaults match design doc ch.11) ------------------------------
MAX_TOTAL_TOKENS=500000
MAX_SEARCH_ROUNDS=10
MAX_WORKERS=3
WARNING_TOKEN_RATIO=0.8
CRITICAL_TOKEN_RATIO=0.95

# ---- API server ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list, e.g. http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173
